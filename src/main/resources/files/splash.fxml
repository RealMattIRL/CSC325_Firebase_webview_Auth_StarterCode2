<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.csc325_firebase_webview_auth.view.SpashController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: #f5f5f5;">

    <VBox alignment="CENTER" spacing="20"
          layoutX="100" layoutY="150" prefWidth="400" prefHeight="150">
        <Label text="Welcome to Firebase Auth App" style="-fx-font-size: 24px; -fx-text-fill: #333;"/>
        <ProgressIndicator fx:id="spinner"/>
        <Button text="Continue" onAction="#handleContinue"/>
    </VBox>

</AnchorPane>
